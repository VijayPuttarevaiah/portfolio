# Copy to .env.local for local development. .env.local is gitignored —
# never commit a real key.

# ---- Contact form (required for it to send at all) ----
# Get from https://resend.com/api-keys — starts with "re_".
# Without this the form returns a clean "not configured" message rather
# than failing silently.
RESEND_API_KEY=

# ---- Contact form (optional) ----
# Where messages are delivered. Defaults to the address in resume.ts.
CONTACT_TO=

# Sender address. The default shared sender works with no domain setup,
# but only delivers to your own Resend account address. Change this only
# after verifying your own domain in Resend.
# CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# ---- Site metadata ----
# Canonical URL, used for Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://vijayputtarevaiah.vercel.app
